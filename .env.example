# Settings for the Docker deployment. Copy to `.env` next to docker-compose.yml and fill in what you
# need (`cp .env.example .env`, then edit it). `.env` is git-ignored: it holds secrets, never commit it.
# After changing it, apply with:  sudo docker compose --profile risk up -d
# Plain KEY=value lines, no quotes needed, no spaces around "=".

# --- Data sources (optional) ---
# ENTSOE_KEY=
# ANTHROPIC_API_KEY=

# --- Who is an admin on /admin/users (comma-separated). Always admin, whatever the database says. ---
ADMIN_EMAILS=you@example.com

# --- Alert emails (see "Alert emails" in the README). Leave ALERT_EMAIL_TO empty to turn them off. ---
# Where alerts go (comma-separate several):
ALERT_EMAIL_TO=you@example.com
# For Gmail: turn on 2-step verification, create an App Password at
# https://myaccount.google.com/apppasswords, and use it below (without the spaces Google shows).
# The SMTP username must be the SAME Gmail account the App Password belongs to.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# SMTP_FROM=            # defaults to SMTP_USER

# --- Sign-in: SESSION_SECRET is generated into data/.session_secret if you leave it unset ---
# SESSION_SECRET=
